  "equations": [
    {
      "label": "EQV20-01",
      "number": "20.1",
      "tex": "\\operatorname{MK}_{\\mathcal P}^{n+1}(F) = \\bigwedge_{i \\in \\mathcal P} \\operatorname{Know}_i\\!\\left(\\operatorname{MK}_{\\mathcal P}^{n}(F)\\right), \\qquad \\operatorname{MK}_{\\mathcal P}^{1}(F) = \\bigwedge_{i \\in \\mathcal P} \\operatorname{Know}_i(F).\\tag{20.1}",
      "asset": "assets/math/f8ef23bd6086319132c4.svg",
      "explanations": [
        "Defines each next mutual-knowledge level by having every party know preceding level.",
        "First level means every party knows F; each later level wraps that group condition once more."
      ]
    },
    {
      "label": "EQV20-02",
      "number": "20.2",
      "tex": "\\operatorname{CK}_{\\mathcal P}(F) \\quad\\Longleftrightarrow\\quad \\bigwedge_{n=1}^{\\infty} \\operatorname{MK}_{\\mathcal P}^{n}(F).\\tag{20.2}",
      "asset": "assets/math/fdc2593e0526f40abc3c.svg",
      "explanations": [
        "Defines common knowledge as every finite mutual-knowledge level holding together.",
        "Common knowledge requires no final depth: levels one, two, and every higher finite level hold."
      ]
    }
  ],
