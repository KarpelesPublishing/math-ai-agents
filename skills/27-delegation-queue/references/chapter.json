  "equations": [
    {
      "label": "EQV27-01",
      "number": "27.1",
      "tex": "\\mathcal A_{\\mathrm{auth}}(x)\n=\\{a\\in\\mathcal A:\\operatorname{Authorized}_{\\mathcal G}(a,x)=1,\n\\;\\operatorname{Pre}(a,x)=1\\}.\n\\tag{27.1}",
      "asset": "assets/math/de77306687ec0648e0c4.svg",
      "explanations": [
        "Defines current authority as actions permitted by declared grants and satisfied state-specific preconditions.",
        "A high-scoring action absent from this set remains a recommendation, not an executable act."
      ]
    },
    {
      "label": "EQV27-02",
      "number": "27.2",
      "tex": "\\operatorname{route}^{\\star}(x)=\n\\begin{cases}\n\\operatorname{Del}(E,\\Delta), & p_E(x)\\geq \\max_y p(y\\mid x),\\\\\n\\arg\\max_y p(y\\mid x), & p_E(x)<\\max_y p(y\\mid x).\n\\end{cases}\n\\tag{27.2}",
      "asset": "assets/math/7975917fee2d7cc96458.svg",
      "explanations": [
        "Routes a zero-one-loss prediction to the classifier or named expert by comparing their conditional chances of correctness.",
        "Deferral begins where expert correctness matches or exceeds the classifier's best class probability, not where confidence merely feels low."
      ]
    },
    {
      "label": "EQV27-03",
      "number": "27.3",
      "tex": "\\mathcal R_{\\mathrm{auth}}(x)=\n\\{(\\mathrm{act},a),(\\mathrm{delegate},d,\\Delta),(\\mathrm{wait},o,\\Delta),(\\mathrm{narrow},a'),(\\mathrm{return})\n\\ \\text{that are authorized at }x\\},\n\\qquad\n\\operatorname{choose}^{\\star}(x)\\in\n\\arg\\max_{\\varrho\\in\\mathcal R_{\\mathrm{auth}}(x)}V(\\varrho,x).\n\\tag{27.3}",
      "asset": "assets/math/b6ceb29c5e478c1354a4.svg",
      "explanations": [
        "Defines candidate routes and selects an authorized act, named delegation, wait, narrow, or return route by declared route value.",
        "Every maximand is one route `\\varrho`, so its value and selected output share one coherent domain."
      ]
    },
    {
      "label": "EQV27-04",
      "number": "27.4",
      "tex": "\\operatorname{wait}^{\\star}(o,\\Delta,x)\n\\quad\\text{only if}\\quad\n\\operatorname{VOI}(o)>\n\\operatorname{DelayCost}(\\Delta,x)\n\\quad\\text{and}\\quad\n\\operatorname{fallback}(\\Delta,x_\\Delta)\\in\\mathcal A_{\\mathrm{auth}}(x_\\Delta)\n\\ \\text{for every reachable }x_\\Delta.\n\\tag{27.4}",
      "asset": "assets/math/f09c52733cdad330374e.svg",
      "explanations": [
        "States a stopping discipline: wait only for a named useful observation, bounded delay, and fallback authorized in every reachable deadline state.",
        "Authority must survive every reachable post-wait state; otherwise delay can leave no permitted next action."
      ]
    }
  ],
