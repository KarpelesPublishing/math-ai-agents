<!doctype html>
<html lang="{{ b.lang|default('en') }}" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="{{ chapter.subtitle }} {{ b.series_line }}.">
<meta name="generator" content="illustrated reader engine {{ engine_version }}">
<title>Chapter {{ chapter.number }}: {{ chapter.title }}. {{ b.series_line }}</title>
<style>{{ css|safe }}</style>
{% if theme_css %}
<style id="book-theme">{{ theme_css|safe }}</style>
{% endif %}
{% if mathjax %}
<script>window.MathJax={tex:{inlineMath:[],displayMath:[['\\[','\\]']],packages:['base','ams','newcommand','noundefined']},svg:{fontCache:'local'},startup:{typeset:false,pageReady:function(){var n=document.querySelectorAll('.equation.text[data-typeset-tex]');for(var i=0;i<n.length;i++){n[i].textContent='\\['+n[i].getAttribute('data-typeset-tex')+'\\]';}return window.MathJax.typesetPromise(Array.prototype.slice.call(n));}}};</script>
<script defer src="{{ mathjax }}"></script>
{% endif %}
</head>
<body>
<a class="skip" href="#main">Skip to the demonstrations</a>
<header>
<nav class="nav" aria-label="Reader navigation"><a href="{{ index_href }}">All chapters</a>{% for key, label, href in links %}<a href="{{ href }}">{{ label }}</a>{% endfor %}</nav>
<p class="eyebrow">{{ b.series_line }} · Chapter {{ chapter.number }}</p>
<h1>{{ chapter.title }}</h1>
<p class="lead">{{ chapter.subtitle }}</p>
<p>{{ chapter.summary }}</p>
{% if b.constructed_notice %}<p class="notice">{{ b.constructed_notice }}</p>{% endif %}
{% if ask_skill %}
<aside class="ask-skill" aria-labelledby="ask-skill-title"><h2 id="ask-skill-title">Ask the chapter skill</h2><p class="ask-skill-name">Chapter skill: {% if ask_skill.href %}<a href="{{ ask_skill.href }}">{{ ask_skill.skill }}</a>{% else %}<span class="skill-name">{{ ask_skill.skill }}</span>{% endif %}. Give it this prompt:</p><p class="ask-prompt">{{ ask_skill.prompt }}</p></aside>
{% endif %}
<nav class="chapter-nav" aria-label="Demonstrations in this chapter">{% for demo in demos %}<a href="#{{ demo.id }}">{{ loop.index }}. {{ demo.title }}</a>{% endfor %}</nav>
</header>
<main id="main">
<noscript><p class="noscript">Each demonstration below shows its default example with its figure, numbers and interpretation. Turn on scripts in your browser to switch among the other precomputed examples.</p></noscript>
{% for demo in demos %}
<section class="demo" id="{{ demo.id }}" aria-labelledby="title-{{ demo.id }}">
<p class="demo-number">Demonstration {{ loop.index }} of {{ demos|length }}</p>
<h2 id="title-{{ demo.id }}">{{ demo.title }}</h2>
<p class="question">{{ demo.question }}</p>
<p>{{ demo.explanation }}</p>
<div class="formula" role="group" aria-label="Equations from the chapter">
{% for eq in demo.equation_blocks %}
{% if eq.kind == 'svg' %}<p class="equation"><img src="{{ eq.src }}" alt="{{ eq.alt }}" {% if eq.typeset %}data-typeset-tex{% else %}data-tex{% endif %}="{{ eq.tex }}" style="{% if eq.width %}width:{{ eq.width }}em;min-width:{{ eq.min_width }}em{% else %}height:{{ eq.height }}em;max-width:none{% endif %}"></p>{% else %}<p class="equation text" data-typeset-tex="{{ eq.tex }}">{{ eq.text }}</p>{% endif %}
{% endfor %}
<p class="scroll-hint equation-hint">Scroll sideways for the whole equation <span aria-hidden="true">&rarr;</span></p>
<p class="symbols">{{ demo.symbols }}</p>
</div>
<p class="prediction"><strong>Predict first.</strong> {{ demo.prediction }}</p>
{% if demo.prediction_options %}
<fieldset class="predict-options"><legend>Your prediction</legend>{% for option in demo.prediction_options %}<label class="predict-option"><input type="radio" name="{{ demo.id }}-prediction" value="{{ loop.index0 }}" autocomplete="off" disabled> {{ option }}</label>{% endfor %}</fieldset>
<p class="prediction-feedback" aria-live="polite" aria-atomic="true"></p>
{% endif %}
<h3 class="sr-only" id="controls-{{ demo.id }}">Choose an example</h3>
<div class="controls" role="group" aria-labelledby="controls-{{ demo.id }}">
{% for control in demo.controls_view %}
<div class="control"><label for="{{ demo.id }}-{{ control.key }}">{{ control.label }}</label><select id="{{ demo.id }}-{{ control.key }}" data-control="{{ control.key }}" autocomplete="off" disabled>{% for o in control.options %}<option value="{{ o.index }}"{% if o.selected %} selected{% endif %}>{{ o.text }}</option>{% endfor %}</select></div>
{% endfor %}
<button type="button" class="reset" hidden>Reset to the default example</button>
{% if demo.stepper_view %}
<div class="stepper" role="group" aria-label="Step through {{ demo.stepper_view.label }}" data-stepper="{{ demo.stepper_view.key }}"><button type="button" class="step-back" hidden{% if demo.stepper_view.at_start %} disabled{% endif %}>Back</button><button type="button" class="step-next" hidden{% if demo.stepper_view.at_end %} disabled{% endif %}>Next</button><span class="step-status" aria-live="polite" aria-atomic="true" hidden>{{ demo.stepper_view.status }}</span></div>
{% endif %}
</div>
<figure class="plot">
<p class="scroll-hint figure-hint">Scroll sideways for the whole figure <span aria-hidden="true">&rarr;</span></p>
<div class="figure-frame" tabindex="0" role="region" aria-label="Figure for {{ demo.title }}; on a narrow screen it scrolls sideways"><img src="{{ demo.default_state.image }}" alt="{{ demo.default_state.alt }}"{% if demo.default_state.min_width %} style="min-width:{{ demo.default_state.min_width }}px"{% endif %}></div>
<figcaption><span class="selected-parameters">{{ demo.default_state.selected }}</span><br>{{ demo.provenance }}</figcaption>
</figure>
<h3 class="sr-only">Calculated values</h3>
<dl class="metrics">{% for label, value in demo.default_state.metrics %}<div class="metric"><dt>{{ label }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl>
<p class="interpretation" aria-live="polite" aria-atomic="true">{{ demo.default_state.interpretation }}</p>
{% if demo.default_state.steps %}
<div class="steps-panel"><h3>Worked steps</h3><ol class="steps">{% for step in demo.default_state.steps %}<li>{{ step }}</li>{% endfor %}</ol></div>
{% endif %}
<div class="columns">
<div class="note"><h3>Use the idea</h3><p>{{ demo.application }}</p></div>
<div class="note"><h3>Where the conclusion applies</h3><p>{{ demo.assumptions }}</p></div>
</div>
{% if demo.misconception %}
<details class="misconception"><summary>Common wrong turn: {{ demo.misconception.title }}</summary><div class="answer">{{ demo.misconception.text }}</div></details>
{% endif %}
{% if demo.scope_note %}
<details class="scope-note"><summary>What this does not settle</summary><div class="answer"><p>{{ demo.scope_note.text }}</p><p class="scope-source">Chapter {{ chapter.number }} source: "{{ demo.scope_note.source_section }}".</p></div></details>
{% endif %}
<details><summary>Check your understanding: {{ demo.check }}</summary><div class="answer">{{ demo.answer }}</div></details>
<p class="source">Chapter {{ chapter.number }} source: section "{{ demo.source_section }}". Demonstration {{ demo.id }}.</p>
</section>
{% endfor %}
{% if pager %}
<nav class="chapter-pager" aria-label="Previous and next chapter">{% if pager.prev %}<a class="prev" href="{{ pager.prev.href }}"><span>&#8592; Chapter {{ pager.prev.number }}</span><b>{{ pager.prev.title }}</b></a>{% endif %}{% if pager.next %}<a class="next" href="{{ pager.next.href }}"><span>Chapter {{ pager.next.number }} &#8594;</span><b>{{ pager.next.title }}</b></a>{% endif %}</nav>
{% endif %}
</main>
<footer>
<p>{{ b.book_title }}{% if b.author %} · {{ b.author }}{% endif %}</p>
{% if b.footer_note %}<p>{{ b.footer_note }}</p>{% endif %}
<p>Every alternative shown here was calculated in advance from the same chapter calculations, so the page works offline. <a href="{{ index_href }}">All chapters</a></p>
</footer>
<script id="reader-data" type="application/json">{{ payload|safe }}</script>
<script>{{ javascript|safe }}</script>
</body>
</html>
