<!doctype html>
<html lang="{{ b.lang|default('en') }}" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="description" content="{{ chapter.subtitle }} {{ b.series_line }}.">
<meta name="generator" content="illustrated reader engine {{ engine_version }}">
<title>Chapter {{ chapter.number }}: {{ chapter.title }}. {{ b.series_line }}</title>
<style>{{ css|safe }}</style>
{% if mathjax %}
<script>window.MathJax={tex:{inlineMath:[['\\(','\\)']],displayMath:[['\\[','\\]']],packages:['base','ams','newcommand','noundefined']},svg:{fontCache:'local'}};</script>
<script defer src="{{ mathjax }}"></script>
{% endif %}
</head>
<body>
<a class="skip" href="#main">Skip to the demonstrations</a>
<header>
<nav class="nav" aria-label="Reader navigation"><a href="{{ index_href }}">All chapters</a>{% for key, label, href in links %}<a href="{{ href }}">{{ label }}</a>{% endfor %}</nav>
<p class="eyebrow">{{ b.series_line }} · Chapter {{ chapter.number }}</p>
<h1>{{ chapter.title }}</h1>
<p class="lead">{{ chapter.subtitle }}</p>
<p>{{ chapter.summary }}</p>
{% if b.constructed_notice %}<p class="notice">{{ b.constructed_notice }}</p>{% endif %}
<nav class="chapter-nav" aria-label="Demonstrations in this chapter">{% for demo in demos %}<a href="#{{ demo.id }}">{{ loop.index }}. {{ demo.title }}</a>{% endfor %}</nav>
</header>
<main id="main">
<noscript><p class="noscript">Each demonstration below shows its default example with its figure, numbers and interpretation. Turn on scripts in your browser to switch among the other precomputed examples.</p></noscript>
{% for demo in demos %}
<section class="demo" id="{{ demo.id }}" aria-labelledby="title-{{ demo.id }}">
<p class="demo-number">Demonstration {{ loop.index }} of {{ demos|length }}</p>
<h2 id="title-{{ demo.id }}">{{ demo.title }}</h2>
<p class="question">{{ demo.question }}</p>
<p>{{ demo.explanation }}</p>
<div class="formula" role="group" aria-label="Equations from the chapter">
{% for eq in demo.equation_blocks %}
{% if eq.kind == 'svg' %}<p class="equation"><img src="{{ eq.src }}" alt="Equation: {{ eq.tex }}" style="height:{{ eq.height }}em"></p>{% else %}<p class="equation tex">\[{{ eq.tex }}\]</p>{% endif %}
{% endfor %}
<p class="symbols">{{ demo.symbols }}</p>
</div>
<p class="prediction"><strong>Predict first.</strong> {{ demo.prediction }}</p>
<h3 class="sr-only" id="controls-{{ demo.id }}">Choose an example</h3>
<div class="controls" role="group" aria-labelledby="controls-{{ demo.id }}">
{% for control in demo.controls_view %}
<div class="control"><label for="{{ demo.id }}-{{ control.key }}">{{ control.label }}</label><select id="{{ demo.id }}-{{ control.key }}" data-control="{{ control.key }}" autocomplete="off" disabled>{% for o in control.options %}<option value="{{ o.index }}"{% if o.selected %} selected{% endif %}>{{ o.text }}</option>{% endfor %}</select></div>
{% endfor %}
<button type="button" class="reset" hidden>Reset to the default example</button>
</div>
<figure class="plot">
<div class="figure-frame" tabindex="0" role="region" aria-label="Figure for {{ demo.title }}; on a narrow screen it scrolls sideways"><img src="{{ demo.default_state.image }}" alt="{{ demo.default_state.alt }}"></div>
<figcaption><span class="selected-parameters">{{ demo.default_state.selected }}</span><br>{{ demo.provenance }}</figcaption>
</figure>
<h3 class="sr-only">Calculated values</h3>
<dl class="metrics">{% for label, value in demo.default_state.metrics %}<div class="metric"><dt>{{ label }}</dt><dd>{{ value }}</dd></div>{% endfor %}</dl>
<p class="interpretation" aria-live="polite" aria-atomic="true">{{ demo.default_state.interpretation }}</p>
<div class="columns">
<div class="note"><h3>Use the idea</h3><p>{{ demo.application }}</p></div>
<div class="note"><h3>Where the conclusion applies</h3><p>{{ demo.assumptions }}</p></div>
</div>
<details><summary>Check your understanding: {{ demo.check }}</summary><div class="answer">{{ demo.answer }}</div></details>
<p class="source">Chapter {{ chapter.number }} source: section "{{ demo.source_section }}". Demonstration {{ demo.id }}.</p>
</section>
{% endfor %}
</main>
<footer>
<p>{{ b.book_title }}{% if b.author %} · {{ b.author }}{% endif %}</p>
{% if b.footer_note %}<p>{{ b.footer_note }}</p>{% endif %}
<p>Every alternative shown here was calculated in advance from the same chapter calculations, so the page works offline. <a href="{{ index_href }}">All chapters</a></p>
</footer>
<script id="reader-data" type="application/json">{{ payload|safe }}</script>
<script>{{ javascript|safe }}</script>
</body>
</html>
